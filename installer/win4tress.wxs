<?xml version="1.0" encoding="utf-8"?>
<!--
  Win4tress's installer (SPEC §17), built by installer/build.ps1: per machine,
  x64, WiX Toolset v7.

  Installs the four programs and the data they read at run time; registers the
  service (starts with Windows as LocalSystem, restarted after a crash) and
  starts it; adds a Start menu shortcut; and starts the app at the installing
  user's sign-in.

  Upgrades: a newer package removes the older one first, then installs, so
  everything in ProgramData\win4tress (history, settings, rules) stays, and so
  does the user's choice about starting at sign-in. Downgrades are refused.

  Uninstalling: undoes what win4tress changed in Windows (DNS routing, its
  firewall rules and profile settings) and keeps ProgramData\win4tress. Only a
  real uninstall does that, never the removal step of an upgrade.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Win4tress"
           Manufacturer="Win4tress"
           Version="$(Version)"
           UpgradeCode="CF893C81-6F8B-4B91-BE34-6D0E4B322691"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Win4tress network monitor and firewall" />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Win4tress is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(Icons)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="win4tress">
        <Directory Id="DataFolder" Name="data">
          <Directory Id="GeoFolder" Name="geo" />
          <Directory Id="OuiFolder" Name="oui" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Win4tress">
      <ComponentGroupRef Id="Programs" />
      <ComponentGroupRef Id="Data" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <ComponentGroup Id="Programs" Directory="INSTALLFOLDER">
      <Component Id="Service">
        <File Id="SvcExe" Source="$(Bin)\win4tress-svc.exe" KeyPath="yes" />
        <ServiceInstall Name="win4tress"
                        DisplayName="Win4tress network monitor"
                        Description="Monitors which apps use the network and enforces win4tress firewall rules."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="service">
          <!-- As `win4tress-svc install`: restarted 5 s after a crash, three times a day. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ServiceControl" Name="win4tress" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Resolver">
        <File Id="DnsExe" Source="$(Bin)\win4tress-dns.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cli">
        <File Id="CliExe" Source="$(Bin)\win4tress.exe" KeyPath="yes" />
      </Component>
      <Component Id="App">
        <File Id="UiExe" Source="$(Bin)\win4tress-ui.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Read at run time from the programs' folder: IP geolocation (DB-IP Lite,
         CC BY 4.0) and device makers (IEEE). -->
    <ComponentGroup Id="Data">
      <Component Directory="GeoFolder">
        <File Source="$(Data)\geo\dbip-country-lite.mmdb" />
      </Component>
      <Component Directory="GeoFolder">
        <File Source="$(Data)\geo\dbip-asn-lite.mmdb" />
      </Component>
      <Component Directory="OuiFolder">
        <File Source="$(Data)\oui\oui.csv" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut"
                Name="Win4tress"
                Description="Network monitor and firewall"
                Target="[INSTALLFOLDER]win4tress-ui.exe"
                WorkingDirectory="INSTALLFOLDER">
        <!-- The app's identity for Windows notifications (Tauri's identifier). -->
        <ShortcutProperty Key="System.AppUserModel.ID" Value="com.win4tress.desktop" />
      </Shortcut>
      <!-- Windows Installer counts the Start menu as the user's: its key path is too. -->
      <RegistryValue Root="HKCU" Key="Software\win4tress\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The running app holds its files: ended first, before Windows Installer
         checks for files in use, on an upgrade (the older version's copy) or
         an uninstall. It has nothing unsaved and is started again afterwards. -->
    <CustomAction Id="QuitApp" FileRef="UiExe" ExeCommand="--quit-others"
                  Execute="immediate" Return="ignore" />

    <!-- Undoes win4tress's changes to Windows; the service has stopped by then. -->
    <CustomAction Id="Cleanup" FileRef="SvcExe" ExeCommand="cleanup"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Starting at sign-in is per user: set as the installing user on a first
         install, removed on uninstall, left as the user chose on upgrades. -->
    <CustomAction Id="StartAtSignIn" FileRef="UiExe" ExeCommand="--autostart on"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="NoStartAtSignIn" FileRef="UiExe" ExeCommand="--autostart off"
                  Execute="immediate" Return="ignore" />
    <!-- Through Explorer, so the app runs as the user, not elevated like the installer. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]win4tress-ui.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="QuitApp" Before="InstallValidate"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="NoStartAtSignIn" After="InstallInitialize"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="Cleanup" After="StopServices"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="StartAtSignIn" After="InstallFinalize"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="LaunchApp" After="StartAtSignIn"
              Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
